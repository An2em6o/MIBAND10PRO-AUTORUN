# ============================================================
#  10pro.autorun 自启动体系 —— 入库忽略规则
#  原则：源码 / 文档 / 当前版产物入库；中间件、历史副本、
#        一次性调试件一律不入库。
# ============================================================

# ---- Python ----
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# ---- 临时 / 中间 / 扫描输出（可重建或一次性）----
_chk_out/
_dropped/
**/target/
**/*.rej
**/*.orig
**/*.bak

# ---- 只留当前产物：历史副本不入库 ----
*.face.prev
*.face.deskdup
*.info.prev
*.rmeta

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
