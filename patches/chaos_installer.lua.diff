+for i = 1, #views do
+  views[i]:clear_flag(lvgl.FLAG.SCROLLABLE)
+  views[i]:add_flag(lvgl.FLAG.CLICKABLE)
+  views[i]:add_flag(lvgl.FLAG.EVENT_BUBBLE)
+end
