+-- ===== 开机自启动(设备侧那半) =====
+-- 做法与同机已跑通的另一个原生应用平台一致, 差别只有节奏(见下面两个延时):
+--   * 命令帧 / rc 脚本 / 开关文件**全部由这里(UI 侧)落盘**; flash 里那句开机 hook 是那个平台打的;
+--   * rc 里"先删开关 -> 干活 -> 整段走完才重建开关" => 窗内重启则停在【关】(防砖);
+--   * 只发 1 条命令(模块自己按 1s 一拍走序列), 所以 rc 里没有 cmds.bin、没有多段时序文件。
+-- 为什么不能 rc 里直接 dd 那几条安装命令: 模块的 write 是**同步**的, 在 sh 任务里
+-- 同步跑注册链会挂死到看门狗 —— 所以只能走"入环即返回"的 CMD_BOOT_DQ。
+local RC_PATH = "/data/rc"
+local RC_HOP = "sh /data/chaos/rc &"   -- 往 RC_PATH 末尾补的二跳(幂等, 已有就不再加)
